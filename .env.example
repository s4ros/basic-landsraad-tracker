# Copy to .env. Compose reads it for the web service. Do not commit .env.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional. Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Production (compose.prod.yaml on the server) reads PUBLIC_HOST,
# POSTGRES_PASSWORD, and AUTH_SECRET from the server .env only.
# See deploy/PRODUCTION.md. The local stack does not use PUBLIC_HOST.
